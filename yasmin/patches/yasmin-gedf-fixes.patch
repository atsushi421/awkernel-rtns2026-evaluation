diff --git a/lib/src/job_pool.c b/lib/src/job_pool.c
index 016e9a6..8d3cbc5 100644
--- a/lib/src/job_pool.c
+++ b/lib/src/job_pool.c
@@ -167,6 +167,11 @@ void y_job_pool_pop_nonblock_if_higher_priority(volatile y_task_pool_t *pool, ya
     }
     if(__builtin_expect(yas_is_higher_priority(pool->q_elt_pool[1].key, priority), TRUE))
         _y_job_pool_pop_unblocked(pool, job);
+    else
+        /* Not popping: restore the semaphore, otherwise the queued task
+         * becomes invisible to blocking pops and is stranded until the next
+         * push wakes a worker. */
+        y_sem_post((y_sem_t *)&pool->cancons);
     y_job_pool_unlock_queue(pool);
 }
 
